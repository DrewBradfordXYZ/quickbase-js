{
  "name": "quickbase-js",
  "version": "3.2.0",
  "description": "TypeScript client for the QuickBase JSON and XML APIs: every endpoint, pagination, retries, code-page temp tokens",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "quickbase-js": "./bin/quickbase-js.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-browser.js",
    "build:node": "tsc",
    "build:browser": "node scripts/build-browser.js",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && tsc -p tsconfig.types.json",
    "spec:normalize": "tsx spec/tools/cli.ts normalize",
    "spec:patch": "tsx spec/tools/cli.ts patch",
    "spec:validate": "tsx spec/tools/cli.ts validate",
    "prespec:generate": "sh scripts/check-spec.sh",
    "spec:generate": "tsx scripts/spec/generate.ts",
    "prespec:build": "sh scripts/check-spec.sh",
    "spec:build": "npm run spec:normalize && npm run spec:patch && npm run spec:validate && npm run spec:generate",
    "docs": "typedoc && node scripts/build-llms.js",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "keywords": [
    "quickbase",
    "api",
    "client",
    "sdk",
    "rest",
    "typescript"
  ],
  "author": "Drew Bradford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrewBradfordXYZ/quickbase-js.git"
  },
  "bugs": {
    "url": "https://github.com/DrewBradfordXYZ/quickbase-js/issues"
  },
  "homepage": "https://github.com/DrewBradfordXYZ/quickbase-js#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "tsx": "^4.7.0",
    "typedoc": "^0.28.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^1.4.0",
    "yaml": "^2.4.0"
  },
  "unpkg": "dist/quickbase.min.js",
  "jsdelivr": "dist/quickbase.min.js",
  "sideEffects": false
}
