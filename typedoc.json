{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "out": "docs",
  "name": "QuickBase JS SDK",
  "readme": "README.md",
  "customJs": "typedoc-custom.js",
  "exclude": [
    "**/*+(test|spec).ts",
    "**/node_modules/**"
  ],
  "excludePrivate": true,
  "excludeInternal": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "searchInComments": true,
  "navigationLinks": {
    "API Methods": "./interfaces/QuickbaseAPI.html",
    "QuickBase API": "https://developer.quickbase.com/",
    "GitHub": "https://github.com/DrewBradfordXYZ/quickbase-js"
  },
  "projectDocuments": [
    "guides/queries.md",
    "guides/schema-aliases.md",
    "guides/authentication.md",
    "guides/reliability.md",
    "guides/xml-api.md",
    "guides/migration.md"
  ]
}
